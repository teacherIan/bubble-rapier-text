{
  "name": "bubble-rapier-text",
  "version": "0.7.1",
  "description": "Physics-driven \"Celebrate your hard work\" bubble text \u2014 PIXI bubble-letters on Rapier rigid bodies with hand-authored collision hulls, plus the interactive hull editor.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pixi",
    "pixijs",
    "rapier",
    "physics",
    "rigid-body",
    "bubble-text",
    "typography",
    "celebrate",
    "react"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bubble-rapier-text.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "OFL.txt",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc -b",
    "prepare": "npm run build:lib",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "@dimforge/rapier2d-compat": "^0.19.0",
    "pixi.js": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "pixi.js": "^8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teacherIan/bubble-rapier-text.git"
  },
  "homepage": "https://github.com/teacherIan/bubble-rapier-text#readme",
  "bugs": {
    "url": "https://github.com/teacherIan/bubble-rapier-text/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/bubble-rapier-text.js"
}
